http://{$GATEWAY_HOST:localhost} {
    redir https://{host}:{$GATEWAY_HTTPS_PORT:443}{uri} 308
}

https://{$GATEWAY_HOST:localhost} {
    @protected {
        path /api/* /ws/*
        not path /api/v1/healthz /api/v1/invitations/claim
    }

    forward_auth @protected {$IDENTITY_API_UPSTREAM:identity-api:8081} {
        uri /api/v1/internal/auth/check
        copy_headers X-User-Id X-User-Sub X-User-Role X-User-Room-Id X-User-Nick
    }

    @health path /healthz
    respond @health 200

    @analytics path_regexp analytics ^/api/v1/rooms/[^/]+/(kpis|reactions/heatmap|timeline)$
    reverse_proxy @analytics analytics:8084

    @identity path /api/*
    reverse_proxy @identity {$IDENTITY_API_UPSTREAM:identity-api:8081}

    @sync path /ws/sync /ws/sync/*
    reverse_proxy @sync sync-core:8080

    @social path /ws/social /ws/social/*
    reverse_proxy @social social-core:8082

    @voice path /ws/voice /ws/voice/*
    reverse_proxy @voice voice-core:8085

    @frontend not path /api/* /ws/*
    reverse_proxy @frontend web:80
}
