http://{$GATEWAY_HOST:localhost} {
    redir https://{host}:{$GATEWAY_HTTPS_PORT:443}{uri} 308
}

(service_timeout) {
    transport http {
        dial_timeout 5s
        response_header_timeout 5s
    }
}

https://{$GATEWAY_HOST:localhost} {
    @missing_correlation not header X-Correlation-ID *
    request_header @missing_correlation X-Correlation-ID {http.request.uuid}
    header X-Correlation-ID {http.request.header.X-Correlation-ID}
    log {
        format json
    }
    log_append correlation_id {http.request.header.X-Correlation-ID}

    handle_errors {
        @upstream_unavailable expression `{http.error.status_code} == 502 || {http.error.status_code} == 503 || {http.error.status_code} == 504`
        header @upstream_unavailable Content-Type application/json
        respond @upstream_unavailable `{"error":"service_unavailable","message":"The requested service is temporarily unavailable."}` 503
    }

    @public path / /healthz /api/v1/healthz /api/v1/invitations/claim
    @protected {
        not path / /healthz /api/v1/healthz /api/v1/invitations/claim
    }

    forward_auth @protected {$IDENTITY_API_UPSTREAM:host.docker.internal:8081} {
        uri /api/v1/internal/auth/check
        copy_headers X-User-Id X-User-Sub X-User-Role X-User-Room-Id X-User-Nick
        import service_timeout
    }

    @root path /
    respond @root 200

    @health path /healthz
    respond @health 200

    @analytics path_regexp analytics ^/api/v1/rooms/[^/]+/(kpis|reactions/heatmap|timeline)$
    reverse_proxy @analytics {$ANALYTICS_UPSTREAM:analytics:8084} {
        import service_timeout
    }

    @voice_api path /api/v1/voice/*
    reverse_proxy @voice_api {$VOICE_CORE_UPSTREAM:voice-core:8085} {
        import service_timeout
    }

    @identity path /api/*
    reverse_proxy @identity {$IDENTITY_API_UPSTREAM:host.docker.internal:8081} {
        import service_timeout
    }

    @sync path /ws/sync /ws/sync/*
    reverse_proxy @sync {$SYNC_CORE_UPSTREAM:sync-core:8080} {
        import service_timeout
    }

    @social path /ws/social /ws/social/*
    reverse_proxy @social {$SOCIAL_CORE_UPSTREAM:social-core:8082} {
        import service_timeout
    }

    @voice path /ws/voice /ws/voice/*
    reverse_proxy @voice {$VOICE_CORE_UPSTREAM:voice-core:8085} {
        import service_timeout
    }

    respond 404
}
