POSTGRES_USER=tint
POSTGRES_PASSWORD=tint
POSTGRES_DB=tint
MINIO_ROOT_USER=tintadmin
MINIO_ROOT_PASSWORD=tintadmin123
MINIO_BUCKET=tint-media
# MongoDB: historial de chat durable (social-core -> SOC-02/SOC-07/DAT-02).
MONGO_ROOT_USER=tint
MONGO_ROOT_PASSWORD=tint
MONGO_DB=tint
MONGO_URI=mongodb://tint:tint@mongodb:27017/tint?authSource=admin
# Hostname used by the public HTTPS entry point. Caddy creates a local certificate for localhost.
GATEWAY_HOST=localhost
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
# Public web entry point and internal identity-api upstream.
WEB_PORT=5173
IDENTITY_API_UPSTREAM=identity-api:8081
# Gateway upstreams: change service addresses here without changing browser routes.
SYNC_CORE_UPSTREAM=sync-core:8080
SOCIAL_CORE_UPSTREAM=social-core:8082
ANALYTICS_UPSTREAM=analytics:8084
VOICE_CORE_UPSTREAM=voice-core:8085
# Internal service URLs used by POST /api/v1/events/start. Each call times out after 5 s.
SYNC_CORE_URL=http://localhost:8083
SOCIAL_CORE_URL=http://localhost:8082
ANALYTICS_URL=http://localhost:8084
# Secreto HS256 compartido entre identity-api (emite tokens) y sync-core (los valida).
JWT_SECRET=dev-secret-change-in-prod
JWT_ISSUER=tint-identity
JWT_AUDIENCE=tint:room
# Login del host (ADR 0024). Por defecto, el Firebase Auth Emulator de docker compose
# (proyecto de demostración demo-tint, sin llamadas a Google). Solo desarrollo: sus ID tokens
# no llevan firma y identity-api solo los acepta con FIREBASE_AUTH_EMULATOR_HOST, NODE_ENV
# distinto de production y un proyecto demo-*. Para usar Firebase real: pon tu proyecto en
# FIREBASE_PROJECT_ID y VITE_FIREBASE_*, y deja vacías FIREBASE_AUTH_EMULATOR_HOST y
# VITE_FIREBASE_AUTH_EMULATOR_URL.
FIREBASE_PROJECT_ID=demo-tint
FIREBASE_AUTH_EMULATOR_HOST=firebase-auth-emulator:9099
SYNC_ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173
SOCIAL_ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173
# Reacciones: límites por usuario e IP (ventana deslizante; defaults 5/5 por 1000 ms).
SOCIAL_REACTION_LIMIT=5
SOCIAL_REACTION_IP_LIMIT=5
SOCIAL_REACTION_WINDOW_MS=1000
# API de solo lectura de analytics (KPIs del host). Orígenes con esquema, separados por comas.
ANALYTICS_PORT=8084
ANALYTICS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Clave del panel administrativo de analitica (vacio = panel deshabilitado).
ANALYTICS_ADMIN_PASSWORD=
# Canal de Voz (voice-core :8085) y STUN/TURN (coturn :3478). TURN_SECRET lo comparten voice-core y coturn.
VOICE_ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173
VOICE_MAX_MEMBERS=8
STUN_URLS=stun:localhost:3478
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_SECRET=dev-turn-secret-change-in-prod
TURN_TTL_SECONDS=3600
# Frontend build-time configuration.
VITE_IDENTITY_API_URL=/api/v1
VITE_FIREBASE_API_KEY=test
VITE_FIREBASE_AUTH_DOMAIN=test
VITE_FIREBASE_PROJECT_ID=demo-tint
# Origen del emulador tal como lo ve el navegador (publicado solo en 127.0.0.1:9099).
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
VITE_SYNC_WS_URL=/ws/sync
VITE_SOCIAL_WS_URL=/ws/social
VITE_VOICE_WS_URL=/ws/voice
VITE_ANALYTICS_API_URL=/api/v1
VITE_SYNC_ENCODING=json

# Transmisión en vivo (stream-core, C++ SFU). STREAM_PUBLIC_IP: IP que alcanza el navegador.
STREAM_CORE_UPSTREAM=stream-core:8086
STREAM_UDP_PORT=8087
STREAM_PUBLIC_IP=127.0.0.1
STREAM_MAX_VIEWERS=50
STREAM_HOST_GRACE_S=60
STREAM_ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173,localhost
# Secreto compartido stream-core -> identity-api (X-Internal-Token). Cámbialo en producción.
INTERNAL_API_SECRET=dev-internal-secret-change-in-prod

# Observabilidad (ADR 0021): logs JSON a stdout y nivel configurable. Un valor inválido
# impide el arranque (env-check lo valida antes de levantar el resto del stack).
LOG_LEVEL=info
GATEWAY_LOG_LEVEL=INFO
NGINX_ERROR_LOG_LEVEL=warn
# media-worker expone /healthz en un puerto interno con heartbeat del consumidor.
MEDIA_WORKER_PORT=8088
MEDIA_WORKER_HEARTBEAT_MAX_AGE_S=30
