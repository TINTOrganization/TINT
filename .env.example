POSTGRES_USER=tint
POSTGRES_PASSWORD=tint
POSTGRES_DB=tint
MINIO_ROOT_USER=tintadmin
MINIO_ROOT_PASSWORD=tintadmin123
MINIO_BUCKET=tint-media
# Hostname used by the public HTTPS entry point. Caddy creates a local certificate for localhost.
GATEWAY_HOST=localhost
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
# identity-api currently runs on the host during local development.
IDENTITY_API_UPSTREAM=host.docker.internal:8081
# Gateway upstreams: change service addresses here without changing browser routes.
SYNC_CORE_UPSTREAM=sync-core:8080
SOCIAL_CORE_UPSTREAM=social-core:8082
ANALYTICS_UPSTREAM=analytics:8084
VOICE_CORE_UPSTREAM=voice-core:8085
# Internal service URLs used by POST /api/v1/events/start. Each call times out after 5 s.
SYNC_CORE_URL=http://localhost:8083
SOCIAL_CORE_URL=http://localhost:8082
ANALYTICS_URL=http://localhost:8084
# Secreto HS256 compartido entre identity-api (emite tokens) y sync-core (los valida).
JWT_SECRET=dev-secret-change-in-prod
JWT_ISSUER=tint-identity
JWT_AUDIENCE=tint:room
SYNC_ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173
SOCIAL_ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173
# Reacciones: límites por usuario e IP (ventana deslizante; defaults 5/5 por 1000 ms).
SOCIAL_REACTION_LIMIT=5
SOCIAL_REACTION_IP_LIMIT=5
SOCIAL_REACTION_WINDOW_MS=1000
# API de solo lectura de analytics (KPIs del host). Orígenes con esquema, separados por comas.
ANALYTICS_PORT=8084
ANALYTICS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Canal de Voz (voice-core :8085) y STUN/TURN (coturn :3478). TURN_SECRET lo comparten voice-core y coturn.
VOICE_ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173
VOICE_MAX_MEMBERS=8
STUN_URLS=stun:localhost:3478
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_SECRET=dev-turn-secret-change-in-prod
TURN_TTL_SECONDS=3600
