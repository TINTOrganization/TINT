IDENTITY_API_PORT=8081
SYNC_CORE_URL=http://localhost:8083
SOCIAL_CORE_URL=http://localhost:8082
ANALYTICS_URL=http://localhost:8084
NODE_ENV=development

AUTH_PROVIDER=firebase

JWT_ISSUER=tint-identity
JWT_AUDIENCE=tint:room
JWT_SECRET=dev-secret-change-in-prod
GUEST_TOKEN_TTL_HOURS=4
INVITATION_DEFAULT_TTL_HOURS=24
# TTL del sync-ticket del host para el WebSocket de sync-core (segundos)
SYNC_TICKET_TTL_SECONDS=600

DATABASE_URL=postgres://tint:tint@localhost:5432/tint?sslmode=disable
REDIS_URL=redis://localhost:6379

# MinIO (S3) para URLs firmadas de reproducción
MINIO_ENDPOINT=http://localhost:9000
# Host que ve el navegador en la URL firmada (opcional; por defecto MINIO_ENDPOINT)
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=tintadmin
MINIO_SECRET_KEY=tintadmin123
MINIO_BUCKET=tint-media
MINIO_REGION=us-east-1
PLAYBACK_URL_TTL_SECONDS=3600
# Subida directa navegador → MinIO (URL PUT firmada)
UPLOAD_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=2147483648

# Proyecto de Firebase (obligatorio: iss/aud de los ID tokens)
FIREBASE_PROJECT_ID=tint-login
