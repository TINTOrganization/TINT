# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# identity-api (login, salas, invitaciones y sync-tickets)
VITE_IDENTITY_API_URL=/api/v1

# Firebase Auth (cliente web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Solo desarrollo (ADR 0024): login del host contra el Firebase Auth Emulator de docker compose.
# Con él, VITE_FIREBASE_PROJECT_ID=demo-tint (el mismo proyecto que identity-api). Vacío = Firebase real.
VITE_FIREBASE_AUTH_EMULATOR_URL=

# Canal Sync de sync-core (WebSocket)
VITE_SYNC_WS_URL=/ws/sync

# Canal social de social-core (chat y reacciones, WebSocket)
VITE_SOCIAL_WS_URL=/ws/social

# Canal de voz de voice-core (señalización WebRTC) a través del gateway.
VITE_VOICE_WS_URL=/ws/voice

# Codificación del Canal Sync: json (por defecto) o msgpack. Con msgpack se pide el
# subprotocolo tint.sync.msgpack; si sync-core no lo acepta, el cliente sigue en JSON.
VITE_SYNC_ENCODING=json

# Vídeo de RESPALDO (MP4/WebM accesible por el navegador). Solo se usa si la sala no
# tiene vídeo asignado en identity-api (GET /rooms/:id/playback devuelve mediaId null).
# Si se deja vacío, el reproductor muestra "Sin video configurado".
VITE_DEMO_VIDEO_URL=

# API de lectura de analytics (KPIs, timeline y heatmap de /rooms/:id/analytics). La web
# le envía como `X-Analytics-Ticket` el analytics-ticket de identity-api (POST /rooms/:id/analytics-ticket).
VITE_ANALYTICS_API_URL=/api/v1

# Transmisión en vivo (stream-core): ORIGEN sin ruta; la web llama a /api/v1/stream/* (WHIP,
# WHEP, ice-servers y sesiones). Con `npm run dev`, stream-core directo en 8086. Vacío = mismo
# origen (así se construye la imagen que sirve el gateway: Caddy enruta /api/v1/stream/*).
VITE_STREAM_API_URL=http://localhost:8086

# API REST de voice-core (escenario de las salas live: PUT/DELETE /api/v1/voice/rooms/{id}/stage/{user_id}).
# Vacío: se usa el origen de VITE_VOICE_WS_URL (ws→http). Con el gateway, su origen.
VITE_VOICE_API_URL=

# Configuración de proxy para desarrollo local (Vite dev server) y servidor SSR de producción.
# Por defecto se conectan a los puertos estándar de docker-compose para cada microservicio.
API_PROXY_TARGET=http://localhost:8081
SYNC_PROXY_TARGET=ws://localhost:8083
SOCIAL_PROXY_TARGET=ws://localhost:8082
VOICE_PROXY_TARGET=ws://localhost:8085
STREAM_PROXY_TARGET=http://localhost:8086
ANALYTICS_PROXY_TARGET=http://localhost:8084
