# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# identity-api (login, salas, invitaciones y sync-tickets)
VITE_IDENTITY_API_URL=http://localhost:8081/api/v1

# Firebase Auth (cliente web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Canal Sync de sync-core (WebSocket)
VITE_SYNC_WS_URL=ws://localhost:8083/ws/sync

# Canal social de social-core (chat y reacciones, WebSocket)
VITE_SOCIAL_WS_URL=ws://localhost:8082/ws/social

# Codificación del Canal Sync: json (por defecto) o msgpack. Con msgpack se pide el
# subprotocolo tint.sync.msgpack; si sync-core no lo acepta, el cliente sigue en JSON.
VITE_SYNC_ENCODING=json

# Vídeo de RESPALDO (MP4/WebM accesible por el navegador). Solo se usa si la sala no
# tiene vídeo asignado en identity-api (GET /rooms/:id/playback devuelve mediaId null).
# Si se deja vacío, el reproductor muestra "Sin video configurado".
VITE_DEMO_VIDEO_URL=

# API de lectura de analytics (KPIs, timeline y heatmap de /rooms/:id/analytics). La web
# le envía como Bearer un analytics-ticket de identity-api (POST /rooms/:id/analytics-ticket).
VITE_ANALYTICS_API_URL=http://localhost:8084/api/v1

# Transmisión en vivo (stream-core): ORIGEN sin ruta; la web llama a /api/v1/stream/* (WHIP,
# WHEP, ice-servers y sesiones). En local, stream-core en 8086; con el gateway, su origen
# (p. ej. https://localhost), donde Caddy enruta /api/v1/stream/* a stream-core.
VITE_STREAM_API_URL=http://localhost:8086

# Canal de Voz de voice-core (WebSocket)
VITE_VOICE_WS_URL=ws://localhost:8085/ws/voice

# API REST de voice-core (escenario de las salas live: PUT/DELETE /api/v1/voice/rooms/{id}/stage/{user_id}).
# Vacío: se usa el origen de VITE_VOICE_WS_URL (ws→http). Con el gateway, su origen.
VITE_VOICE_API_URL=
